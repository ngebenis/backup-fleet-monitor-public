# Placeholders only. Real .env is generated on the host (chmod 600), never committed.
POSTGRES_PASSWORD=change-me
# 64 hex chars (32 bytes). Encrypts stored source credentials (AES-256-GCM).
# Generate with:  openssl rand -hex 32
# Losing or changing this key makes stored source credentials unreadable.
SECRET_KEY=
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-min-12-chars
WEB_PORT=8081
# Session cookie "Secure" flag. Keep true and serve over HTTPS (reverse proxy /
# load balancer terminating TLS). Set false ONLY for plain-HTTP local testing,
# otherwise the session cookie is sent in clear text.
COOKIE_SECURE=true
SESSION_TTL=12h
